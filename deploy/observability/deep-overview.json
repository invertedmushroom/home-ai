            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.5, sum by(le,backend,outcome)(rate(deep_run_duration_seconds_bucket{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
              "legendFormat": "{{backend}} · {{outcome}} · P50"
            },
            {
              "refId": "B",
              "expr": "histogram_quantile(0.95, sum by(le,backend,outcome)(rate(deep_run_duration_seconds_bucket{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
              "legendFormat": "{{backend}} · {{outcome}} · P95"
            }
          ],
          "gridPos": {
            "x": 8,
            "y": 22,
            "w": 8,
            "h": 8
          }
        },
        {
          "id": 7,
          "title": "Resource wait · P50 / P95",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "description": "Successful acquisitions only. Cancelled/rejected waits are excluded.",
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "noValue": "No observations",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "stepAfter",
