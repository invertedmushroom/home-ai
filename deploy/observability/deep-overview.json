              "expr": "histogram_quantile(0.5, sum by(le,resource_group,outcome)(rate(deep_model_recovery_duration_seconds_bucket{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
              "legendFormat": "{{resource_group}} · {{outcome}} · P50"
            },
            {
              "refId": "B",
              "expr": "histogram_quantile(0.95, sum by(le,resource_group,outcome)(rate(deep_model_recovery_duration_seconds_bucket{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
              "legendFormat": "{{resource_group}} · {{outcome}} · P95"
