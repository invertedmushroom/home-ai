          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.5, sum by(le, backend)(rate(deep_model_duration_seconds_bucket{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
              "legendFormat": "{{backend}} · P50"
            },
            {
              "refId": "B",
              "expr": "histogram_quantile(0.95, sum by(le, backend)(rate(deep_model_duration_seconds_bucket{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
              "legendFormat": "{{backend}} · P95"
            }
          ]
        },
        {
          "id": 9,
          "title": "Image communication attempt · P50 / P95",
          "type": "timeseries",
          "gridPos": {
