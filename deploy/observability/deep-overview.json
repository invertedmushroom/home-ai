{
  "uid": "deep-overview",
  "title": "Deep · development overview",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": ["deep", "local"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Deep process",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(deep_observability_snapshot_timestamp_seconds{service_name=\"deep-server\"},service_instance_id)",
          "refId": "instance"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "runtime",
        "label": "Runtime",
        "type": "custom",
        "query": "llama-server,wangp",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "log_search",
        "label": "Log contains",
        "type": "textbox",
        "query": "",
        "current": {
          "selected": true,
          "text": "",
          "value": ""
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Live status",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "Sample age",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          },
          "noValue": "No heartbeat"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - min(deep_observability_snapshot_timestamp_seconds{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"})",
          "instant": true
        }
      ],
      "description": "Worst age across selected processes. Red after 15 seconds. A stopped process can remain visible until Prometheus marks its series stale."
    },
    {
      "id": 22,
      "title": "Read errors",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "None observed",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(deep_observability_snapshot_failures_total{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"})",
          "instant": true
        }
      ],
      "description": "Failures observed since the selected processes started. An absent counter means no failure observation was exported; check sampler age too."
    },
    {
      "id": 2,
      "title": "Queued",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(deep_run_queued{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Running",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(deep_run_active{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Unresolved",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(deep_ownership_unresolved{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 23,
      "title": "Acquired",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(deep_resource_acquisitions_total{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\",outcome=\"acquired\"})",
          "instant": true
        }
      ],
      "description": "Successful stage acquisitions since selected process startup. This is cumulative, not GPU utilization."
    },
    {
      "id": 5,
      "title": "Deep resource slots and waiters",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "showPoints": "never",
            "axisSoftMax": 1
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(resource_group)(deep_resource_active{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"})",
          "legendFormat": "{{resource_group}} · active"
        },
        {
          "refId": "B",
          "expr": "sum by(resource_group)(deep_resource_queued{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"})",
          "legendFormat": "{{resource_group}} · waiting"
        }
      ],
      "description": "These are Deep's leased stage slots, not whole-device GPU utilization. Other runtimes/clients can bypass them."
    },
    {
      "id": 24,
      "title": "Throughput / minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Settled runs, returned model calls and acquired resource stages per minute. Multi-turn/image runs can make multiple calls/acquisitions. Rates need at least two exported samples.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:/min",
          "noValue": "No observations",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 8,
            "showPoints": "never",
            "axisSoftMax": 1
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by(backend)(rate(deep_run_finished_total{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{backend}} · runs"
        },
        {
          "refId": "B",
          "expr": "60 * sum by(backend)(rate(deep_model_calls_total{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{backend}} · model calls"
        },
        {
          "refId": "C",
          "expr": "60 * sum by(resource_group)(rate(deep_resource_acquisitions_total{outcome=\"acquired\",service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{resource_group}} · acquired stages"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 25,
      "title": "Recent runs · click a trace",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Newest root run traces in the selected time range/processes. Delivery/search can lag by about 30 seconds. Trace duration can include owned cleanup after the parent settles.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"deep-server\" && name = \"run\" && resource.service.instance.id =~ \"${instance:regex}\" } with (most_recent=true)",
          "limit": 25,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": true
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 101,
      "title": "Latency · queues, generation and recovery",
      "type": "row",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 30,
          "title": "Initial run queue · P50 / P95",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "description": "Admission to the first stage, from the persisted run receipt. Later stage waits appear in resource wait.",
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "noValue": "No observations",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "stepAfter",
                "fillOpacity": 8,
                "showPoints": "never"
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": ["lastNotNull"]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.5, sum by(le,backend,outcome)(rate(deep_run_queue_duration_seconds_bucket{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
              "legendFormat": "{{backend}} · {{outcome}} · P50"
            },
            {
              "refId": "B",
              "expr": "histogram_quantile(0.95, sum by(le,backend,outcome)(rate(deep_run_queue_duration_seconds_bucket{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
              "legendFormat": "{{backend}} · {{outcome}} · P95"
            }
          ],
          "gridPos": {
            "x": 0,
            "y": 22,
            "w": 8,
            "h": 8
          }
        },
        {
          "id": 31,
          "title": "Parent run duration · P50 / P95",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "description": "Persisted active parent duration, excluding initial queue time. Owned cleanup can outlive this duration; inspect the trace.",
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "noValue": "No observations",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "stepAfter",
                "fillOpacity": 8,
                "showPoints": "never"
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
