          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.5, sum by(le, outcome)(rate(deep_image_duration_seconds_bucket{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
              "legendFormat": "{{outcome}} · P50"
            },
            {
              "refId": "B",
              "expr": "histogram_quantile(0.95, sum by(le, outcome)(rate(deep_image_duration_seconds_bucket{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
              "legendFormat": "{{outcome}} · P95"
            }
          ],
          "description": "Includes image queueing, MCP communication and cleanup. Reconciliation creates another communication attempt."
        },
        {
          "id": 32,
          "title": "Native recovery duration · P50 / P95",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "description": "",
          "fieldConfig": {
            "defaults": {
