            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.5, sum by(le,resource_group)(rate(deep_resource_wait_duration_seconds_bucket{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
              "legendFormat": "{{resource_group}} · P50"
            },
            {
              "refId": "B",
              "expr": "histogram_quantile(0.95, sum by(le,resource_group)(rate(deep_resource_wait_duration_seconds_bucket{service_name=\"deep-server\",service_instance_id=~\"${instance:regex}\"}[$__rate_interval])))",
              "legendFormat": "{{resource_group}} · P95"
            }
          ],
          "gridPos": {
            "x": 16,
            "y": 22,
            "w": 8,
            "h": 8
          }
        },
        {
          "id": 8,
          "title": "Model HTTP duration · P50 / P95",
          "type": "timeseries",
          "gridPos": {
            "x": 0,
            "y": 30,
            "w": 8,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "drawStyle": "line",
