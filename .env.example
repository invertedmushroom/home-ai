# Demo works without a model, GPU, API key, Python, Docker or WSL.
DEEP_PROVIDER=demo
DEEP_BIND=127.0.0.1:4318
DEEP_DATA_DIR=data
DEEP_WEB_DIR=apps/web/dist
# Leave unset for the local operator UI. An exact HTTPS origin enables guests
# for every browser, including yours. Keep DEEP_BIND on loopback.
# Setup, private exposure and operator access: docs/operations/demo.md.
# DEEP_PUBLIC_ORIGIN=
# CARGO_TARGET_DIR=target

# Optional catalog of named connections and models. When connections are present,
# model definitions live in this file; legacy model env vars below are ignored.
# Keep credentials in env vars referenced by each connection's api_key_env.
# The example leaves task preferences empty for manual model selection.
# DEEP_MODEL_PROFILES_FILE=deploy/models/profiles.example.json
# DEEP_MODEL_TIMEOUT_SECONDS=180
# DEEP_MODEL_MAX_OUTPUT_TOKENS=4096
# For long local generation, set DEEP_MODEL_TIMEOUT_SECONDS=1800 (30 minutes).

# To use a running llama-server or another compatible chat backend:
# DEEP_PROVIDER=compatible
# DEEP_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# DEEP_MODEL_ID=your-loaded-model
# DEEP_MODEL_API_KEY=
# Optional native llama-server recovery; requires llama-server --metrics.
# Direct loopback /v1 endpoint only. Leave unset for generic compatible servers.
# DEEP_MODEL_RUNTIME=llamacpp

# Named text backends are enabled by setting a model ID. Keys alone enable none.
# The selected backend receives the completed conversation. No automatic fallback.
# DEEP_DEFAULT_BACKEND=lmstudio
# DEEP_LMSTUDIO_MODEL=google/gemma-4-e4b
# DEEP_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# DEEP_LMSTUDIO_API_KEY=
# DEEP_GROQ_MODEL=openai/gpt-oss-120b
# DEEP_OPENAI_MODEL=gpt-5.4-mini

# Optional resource groups. Defaults serialize LM Studio, compatible/llama-server
# and WanGP on local-gpu. Hosted backends default to their provider ID.
# Assign different groups only when the runtimes use independent hardware.
# DEEP_MODEL_RESOURCE_GROUP=local-gpu
# DEEP_LMSTUDIO_RESOURCE_GROUP=local-gpu
# DEEP_OPENAI_RESOURCE_GROUP=openai
# DEEP_GROQ_RESOURCE_GROUP=groq
# Image profiles accept an optional resource_group field (default local-gpu).

# Optional Node execution. Build workers/node/Dockerfile first; Linux Docker only.
# Explicit UI action on saved revisions; no automatic execution or package install.
# DEEP_WORKER_IMAGE=deep-node-worker:local

# Optional per-request web search. Start deploy/search first, then restart Deep.
# Default-off checkbox; model queries leave for SearXNG's configured upstream.
# DEEP_SEARXNG_URL=http://127.0.0.1:8888
# DEEP_SEARXNG_ENGINE=brave

# Optional image presets. WanGP requires its shared web-UI MCP server.
# OpenAI generation/editing presets use OPENAI_API_KEY; examples can be merged
# from deploy/images/profiles.openai.example.json into your local preset array.
# The JSON file contains named fixed profiles; no runtime is started by Deep.
# DEEP_IMAGE_PROFILES_FILE=deploy/images/profiles.example.json

TYPESAFE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
JEV_MODEL=

# Optional local traces/metrics. Start npm run observability:up, then restart Deep.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14318
# OTEL_SDK_DISABLED=true

# Optional raw runtime logs; npm run observability:logs enables the separate agent.
# Directories are mounted read-only. Keep globs limited to these runtimes' logs.
# DEEP_LLAMA_LOG_DIR=../../logs/llama-server
# DEEP_LLAMA_LOG_GLOB=*.log
# DEEP_WANGP_LOG_DIR=../../logs/wangp
# DEEP_WANGP_LOG_GLOB=*.log
# DEEP_LOG_HOST=local

# Optional standalone OpenAI search probe; explicit --provider openai is required.
# Independent of the selected chat model; API calls can incur charges.
# DEEP_OPENAI_SEARCH_MODEL=gpt-5.4-mini

# Optional private guest mode behind Tailscale Serve. Use a separate DEEP_DATA_DIR.
# Set DEEP_PUBLIC_ORIGIN, DEEP_BIND and DEEP_DATA_DIR above as documented there.
# Serve uses your existing Tailscale login; these keys are not needed by Deep.
TAILSCALE_AUTH_KEY=
TAILSCALE_API_KEY=
